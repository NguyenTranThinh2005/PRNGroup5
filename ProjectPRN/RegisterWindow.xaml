<Window x:Class="Presentation.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation"
        mc:Ignorable="d"
        Title="RegisterWindow" Height="450" Width="800">
    <Grid Background="#f0f4f8">
        <Border Background="White" Width="400" Height="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="10" Padding="30">
            <StackPanel>
                <TextBlock Text="ĐĂNG KÝ" FontSize="22" FontWeight="Bold"
                           Foreground="#2A4365" TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Username -->
                <TextBlock Text="Tên người dùng" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Height="35" Margin="0,0,0,10"/>

                <!-- Email -->
                <TextBlock Text="Email" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Height="35" Margin="0,0,0,10"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,0,0,10"/>

                <!-- Confirm Password -->
                <TextBlock Text="Xác nhận mật khẩu" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="35" Margin="0,0,0,20"/>

                <!-- Button -->
                <Button Content="Đăng ký"
                        Background="#2A4365" Foreground="White"
                        FontWeight="Bold" Height="40"
                        Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
